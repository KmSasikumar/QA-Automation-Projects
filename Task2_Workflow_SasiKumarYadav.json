{
  "name": "Task2 Morning Brief - HackerNews Digest (Sasi Kumar Yadav)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "8d22ec5c-af44-4a86-9525-655cd9469ca1",
      "name": "Every Hour (testing)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        220,
        300
      ]
    },
    {
      "parameters": {
        "url": "https://hacker-news.firebaseio.com/v0/topstories.json",
        "options": {
          "timeout": 30000
        }
      },
      "id": "2fb3aa71-1424-44bf-b0b6-2bf06309f61f",
      "name": "HN Top Stories",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        300
      ],
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "// Keep only the first 10 story IDs to bound the enrichment calls.\n// The list endpoint returns a bare JSON array; n8n may surface it as one\n// array item or as one item per ID - handle both shapes.\nconst first = $input.first().json;\nconst ids = Array.isArray(first) ? first : $input.all().map(i => i.json).filter(v => typeof v === 'number');\nreturn ids.slice(0, 10).map(id => ({ json: { id } }));"
      },
      "id": "71f22cde-0422-43c8-9b62-f742b9bfb56d",
      "name": "Take First 10 IDs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        300
      ]
    },
    {
      "parameters": {
        "url": "=https://hacker-news.firebaseio.com/v0/item/{{ $json.id }}.json",
        "options": {
          "timeout": 30000
        }
      },
      "id": "2b2a9e1f-76a2-49e7-ba80-89d7b4b5ce69",
      "name": "HN Item Details",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        300
      ],
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 3000
    },
    {
      "parameters": {
        "jsCode": "// Filter dead/deleted/job items, rank by score, keep top 5.\nconst items = $input.all().map(i => i.json)\n  .filter(s => s && s.type === 'story' && !s.deleted && !s.dead && s.title);\nitems.sort((a, b) => (b.score || 0) - (a.score || 0));\nconst top = items.slice(0, 5);\nconst lines = top.map((s, i) => `${i + 1}. ${s.title} (${s.score} pts) - ${s.url || ('https://news.ycombinator.com/item?id=' + s.id)}`);\nreturn [{ json: { topScore: top.length ? (top[0].score || 0) : 0, count: top.length, lines, digest: lines.join('\\n') } }];"
      },
      "id": "40af7913-703c-415e-838c-423435c936a0",
      "name": "Top 5 Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        300
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "daa17565-c764-4dba-83ff-b411b8643eaa",
              "leftValue": "={{ $json.topScore }}",
              "rightValue": 200,
              "operator": {
                "type": "number",
                "operation": "gte",
                "name": "filter.operator.number.gte"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "321e75bb-78d5-475c-b7a9-3db18042ee82",
      "name": "Hot Day? (top score >= 200)",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1320,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nreturn [{ json: { message: 'MORNING BRIEF - HOT DAY (top story ' + d.topScore + ' pts)\\n' + d.digest } }];"
      },
      "id": "79064336-d861-42d7-88ff-142a954dce7b",
      "name": "Format Hot Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        200
      ]
    },
    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nreturn [{ json: { message: 'MORNING BRIEF - Top ' + d.count + ' HackerNews stories\\n' + d.digest } }];"
      },
      "id": "624006fa-f3f9-40fc-baf0-8d09a7685dee",
      "name": "Format Normal Digest",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1540,
        420
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DISCORD_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { content: $json.message } }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "b0ed98e2-8013-4de7-a2ca-4a6e6d8e5b6c",
      "name": "Post to Discord (webhook via env)",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1780,
        300
      ],
      "onError": "continueErrorOutput",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 5000
    },
    {
      "parameters": {
        "jsCode": "// Error branch: never fail silently - log a structured line and notify.\nconst e = $input.first().json;\nconst msg = (e.error && e.error.message) || e.message || 'unknown error';\nconsole.log('MORNING-BRIEF ERROR', msg);\nreturn [{ json: { message: 'Morning brief FAILED at a fetch step: ' + msg } }];"
      },
      "id": "5e418115-86b2-4c30-b99f-6dd28f1355e2",
      "name": "Log Failure",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        560
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.DISCORD_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ { content: $json.message } }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "bddc0993-e705-49e2-ade1-f502a6e07079",
      "name": "Post Failure Notice",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        560
      ]
    }
  ],
